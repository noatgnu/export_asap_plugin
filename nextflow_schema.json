{
    "$schema": "http://json-schema.org/draft-07/schema",
    "title": "Export ASAP pipeline parameters",
    "description": "Exports ASAP files from an SDRF file.",
    "type": "object",
    "definitions": {
        "plugin_parameters": {
            "title": "Plugin parameters",
            "description": "Parameters for the Export ASAP plugin.",
            "type": "object",
            "properties": {
                "alternate_dataset_id": {
                    "type": "string",
                    "description": "External dataset identifier such as ProteomeXchange ID. Example: PXD042502",
                    "default": ""
                },
                "asap_grant_id": {
                    "type": "string",
                    "description": "ASAP grant identifier. Example: ASAP-000463",
                    "default": ""
                },
                "asap_lab_name": {
                    "type": "string",
                    "description": "Name of the ASAP lab.",
                    "default": "Dario Alessi"
                },
                "asap_team_name": {
                    "type": "string",
                    "description": "Name of the ASAP team.",
                    "default": "Alessi"
                },
                "contributor_names": {
                    "type": "string",
                    "description": "Comma-separated list of all contributors. Example: Prosenjit Pal, Matthew Taylor, Pui Yiu Lam",
                    "default": ""
                },
                "dataset_description": {
                    "type": "string",
                    "description": "Description of the dataset including experimental details. Auto-detected from SDRF if empty.",
                    "default": ""
                },
                "dataset_name": {
                    "type": "string",
                    "description": "Short identifier for the dataset. Example: VPS35_D620N_Brain_LysoIP",
                    "default": ""
                },
                "dataset_title": {
                    "type": "string",
                    "description": "Title for the dataset, often matching the publication title. Example: Parkinson's VPS35[D620N] mutation induces LRRK2-mediated lysosomal association of RILPL1 and TMEM55B",
                    "default": ""
                },
                "dua_version": {
                    "type": "string",
                    "description": "Data Use Agreement version. Use NA if not applicable.",
                    "default": ""
                },
                "metadata_tables": {
                    "type": "string",
                    "description": "Comma-separated list of metadata files. Example: SDRF.tsv, intervention.csv, STUDY.csv",
                    "default": "SDRF.tsv"
                },
                "metadata_version_date": {
                    "type": "string",
                    "description": "Date of metadata version. Format: M/D/YYYY. Example: 4/7/2025",
                    "default": ""
                },
                "number_samples": {
                    "type": "string",
                    "description": "Total number of samples. Auto-detected from SDRF if empty.",
                    "default": ""
                },
                "other_funding_source": {
                    "type": "string",
                    "description": "Additional funding sources beyond ASAP. Use NA if none.",
                    "default": ""
                },
                "pi_email": {
                    "type": "string",
                    "description": "Email address of the Principal Investigator. Example: d.r.alessi@dundee.ac.uk",
                    "default": ""
                },
                "pi_full_name": {
                    "type": "string",
                    "description": "Full name of the Principal Investigator.",
                    "default": "Dario R. Alessi"
                },
                "pi_google_scholar_id": {
                    "type": "string",
                    "description": "Google Scholar ID of the PI. Use NA if not available.",
                    "default": ""
                },
                "pi_orcid": {
                    "type": "string",
                    "description": "ORCID identifier of the PI. Example: 0000-0002-2140-9185",
                    "default": ""
                },
                "preprocessing_references": {
                    "type": "string",
                    "description": "References for data preprocessing methods. Use NA if not applicable.",
                    "default": ""
                },
                "project_description": {
                    "type": "string",
                    "description": "Detailed description of the research project goals and scope.",
                    "default": ""
                },
                "project_name": {
                    "type": "string",
                    "description": "Official ASAP project name. Example: Mapping the LRRK2 Signalling Pathway and Its Interplay with Other Parkinson's Disease Components.",
                    "default": ""
                },
                "publication_doi": {
                    "type": "string",
                    "description": "DOI of the associated publication. Example: 10.1126/sciadv.adj1205",
                    "default": ""
                },
                "publication_pmid": {
                    "type": "string",
                    "description": "PubMed ID of the associated publication. Example: 38091401",
                    "default": ""
                },
                "sample_types": {
                    "type": "string",
                    "description": "Types of samples in the dataset. Example: Mouse Brain. Auto-detected from SDRF if empty.",
                    "default": ""
                },
                "sdrf_file": {
                    "type": "string",
                    "description": "The input SDRF file in .tsv format.",
                    "format": "file-path"
                },
                "submitter_email": {
                    "type": "string",
                    "description": "Email of the data submitter. Example: r.nirujogi@dundee.ac.uk",
                    "default": ""
                },
                "submitter_name": {
                    "type": "string",
                    "description": "Name of the person submitting the data. Example: Dr. Raja Nirujogi",
                    "default": ""
                },
                "types_of_samples": {
                    "type": "string",
                    "description": "Assay types in the dataset. Example: Proteomics (Organelle-IP). Auto-detected from SDRF if empty.",
                    "default": ""
                }
            }
        }
    },
    "properties": {
        "alternate_dataset_id": {
            "$ref": "#/definitions/plugin_parameters/properties/alternate_dataset_id"
        },
        "asap_grant_id": {
            "$ref": "#/definitions/plugin_parameters/properties/asap_grant_id"
        },
        "asap_lab_name": {
            "$ref": "#/definitions/plugin_parameters/properties/asap_lab_name"
        },
        "asap_team_name": {
            "$ref": "#/definitions/plugin_parameters/properties/asap_team_name"
        },
        "contributor_names": {
            "$ref": "#/definitions/plugin_parameters/properties/contributor_names"
        },
        "dataset_description": {
            "$ref": "#/definitions/plugin_parameters/properties/dataset_description"
        },
        "dataset_name": {
            "$ref": "#/definitions/plugin_parameters/properties/dataset_name"
        },
        "dataset_title": {
            "$ref": "#/definitions/plugin_parameters/properties/dataset_title"
        },
        "dua_version": {
            "$ref": "#/definitions/plugin_parameters/properties/dua_version"
        },
        "metadata_tables": {
            "$ref": "#/definitions/plugin_parameters/properties/metadata_tables"
        },
        "metadata_version_date": {
            "$ref": "#/definitions/plugin_parameters/properties/metadata_version_date"
        },
        "number_samples": {
            "$ref": "#/definitions/plugin_parameters/properties/number_samples"
        },
        "other_funding_source": {
            "$ref": "#/definitions/plugin_parameters/properties/other_funding_source"
        },
        "pi_email": {
            "$ref": "#/definitions/plugin_parameters/properties/pi_email"
        },
        "pi_full_name": {
            "$ref": "#/definitions/plugin_parameters/properties/pi_full_name"
        },
        "pi_google_scholar_id": {
            "$ref": "#/definitions/plugin_parameters/properties/pi_google_scholar_id"
        },
        "pi_orcid": {
            "$ref": "#/definitions/plugin_parameters/properties/pi_orcid"
        },
        "preprocessing_references": {
            "$ref": "#/definitions/plugin_parameters/properties/preprocessing_references"
        },
        "project_description": {
            "$ref": "#/definitions/plugin_parameters/properties/project_description"
        },
        "project_name": {
            "$ref": "#/definitions/plugin_parameters/properties/project_name"
        },
        "publication_doi": {
            "$ref": "#/definitions/plugin_parameters/properties/publication_doi"
        },
        "publication_pmid": {
            "$ref": "#/definitions/plugin_parameters/properties/publication_pmid"
        },
        "sample_types": {
            "$ref": "#/definitions/plugin_parameters/properties/sample_types"
        },
        "sdrf_file": {
            "$ref": "#/definitions/plugin_parameters/properties/sdrf_file"
        },
        "submitter_email": {
            "$ref": "#/definitions/plugin_parameters/properties/submitter_email"
        },
        "submitter_name": {
            "$ref": "#/definitions/plugin_parameters/properties/submitter_name"
        },
        "types_of_samples": {
            "$ref": "#/definitions/plugin_parameters/properties/types_of_samples"
        }
    }
}